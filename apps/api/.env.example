# Anthropic
ANTHROPIC_API_KEY=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:4000/auth/github/callback

# Session
SESSION_SECRET=change-me-in-production

# Redis
REDIS_URL=redis://localhost:6379

# Graphiti Python microservice
GRAPHITI_SERVICE_URL=http://localhost:8001

# Letta (optional — used for large repos >20k lines)
LETTA_BASE_URL=http://localhost:8283

# Temp directory for cloned repos
TEMP_DIR=/tmp/sessions

# Frontend URL (for CORS and OAuth redirect)
FRONTEND_URL=http://localhost:3000
